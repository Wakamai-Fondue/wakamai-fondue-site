{
	"name": "wakamai-fondue",
	"version": "2.2.0",
	"type": "module",
	"private": true,
	"scripts": {
		"serve": "vite serve",
		"build": "vite build",
		"lint": "npm-run-all lint:**",
		"lint:eslint": "eslint \"src/**/*.{js,vue}\" --max-warnings=0",
		"lint:prettier": "prettier --check \"src/**/*.{js,vue}\"",
		"lint-fix": "npm-run-all --sequential lint-fix:** prettier",
		"lint-fix:eslint": "eslint \"src/**/*.{js,vue}\" --fix",
		"prettier": "prettier --write \"src/**/*.{js,vue}\""
	},
	"dependencies": {
		"@wakamai-fondue/engine": "git+https://github.com/Wakamai-Fondue/wakamai-fondue-engine.git#9ec4a3fde76b76580550c614d88d26e163653c11",
		"prismjs": "^1.30.0",
		"vue": "^3.5.45",
		"vue-prism-component": "^2.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@vitejs/plugin-vue": "^6.0.11",
		"eslint": "^10.15.0",
		"eslint-plugin-vue": "^10.12.1",
		"globals": "^17.14.0",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.10.1",
		"vite": "^8.3.8"
	},
	"engines": {
		"node": ">=22"
	},
	"allowScripts": {
		"@wakamai-fondue/engine": true,
		"fsevents": true
	}
}

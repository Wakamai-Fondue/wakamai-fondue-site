{
	"name": "wakamai-fondue",
	"version": "2.1.0",
	"type": "module",
	"private": true,
	"scripts": {
		"serve": "vite serve",
		"build": "vite build",
		"lint": "npm-run-all lint:**",
		"lint:eslint": "eslint \"src/**/*.{js,vue}\" --max-warnings=0",
		"lint:prettier": "prettier --check \"src/**/*.{js,vue}\"",
		"lint-fix": "npm-run-all --sequential lint-fix:** prettier",
		"lint-fix:eslint": "eslint \"src/**/*.{js,vue}\" --fix",
		"prettier": "prettier --write \"src/**/*.{js,vue}\""
	},
	"dependencies": {
		"@wakamai-fondue/engine": "git+https://github.com/Wakamai-Fondue/wakamai-fondue-engine.git#f65fcb7351218c536635fefb61f94ad0815b92a0",
		"prismjs": "^1.30.0",
		"vue": "^3.5.42",
		"vue-prism-component": "^2.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.0",
		"@vitejs/plugin-vue": "^6.0.8",
		"eslint": "^10.0.0",
		"eslint-plugin-vue": "^10.0.0",
		"globals": "^17.0.0",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.0.0",
		"vite": "^8.2.2"
	},
	"engines": {
		"node": ">=22"
	},
	"allowScripts": {
		"@wakamai-fondue/engine": true,
		"fsevents": true
	}
}
